{erl_opts, [debug_info]}.
{edoc_opts, [{preprocess, true}]}.

{deps, [
    {cowboy, "2.10.0"},
    {eredis, "1.2.0"},
    {meck, "0.9.2"}
]}.

{relx, [
    {release, {erlang, "0.1.0"},
         [erlang,
          sasl,
          cowboy,
          eredis]},

        {sys_config, "./config/sys.config"},
        {vm_args, "./config/vm.args"},

        {dev_mode, true},
        {include_erts, false},

        {extended_start_script, true}]}.

{alias,[
    {test,
        [eunit]}
]}.

{profiles, [{prod, [{relx, [{dev_mode, false},
                           {include_erts, true}]}]}]}.
